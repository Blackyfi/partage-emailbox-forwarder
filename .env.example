# Partage / CAS credentials. The username is your CAS login, not an email.
PARTAGE_USERNAME=your_cas_login
# Quote the password if it contains spaces, '#' or '$'.
PARTAGE_PASSWORD='your_password_here'

# Gmail SMTP: use an App Password, not the account password
FORWARD_TO=your.email@gmail.com
GMAIL_USER=your.sender@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional
# PARTAGE_URL=https://partage.bordeaux-inp.fr/mail
# PARTAGE_QUERY=in:inbox
# POLL_INTERVAL_SECONDS=300
# SUBJECT_PREFIX=[Partage]
# MAX_ATTEMPTS=5
# HTTP_TIMEOUT_SECONDS=30
# LOG_LEVEL=INFO
# DB_PATH=/data/emails.db
